module autoware_sensing_msgs {
  module msg {
    struct GnssInsOrientation {
      geometry_msgs::msg::Quaternion orientation;

      float rmse_rotation_x;

      float rmse_rotation_y;

      float rmse_rotation_z;
    };
  };
};
