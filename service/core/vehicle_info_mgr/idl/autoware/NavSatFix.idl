// NOTE (2026-08-10): the @unit annotations that ROS 2's rosidl_adapter emits here were
// REMOVED. fastddsgen 4.3.0 mis-generates them into TypeObjectSupport as a bare identifier
// (`unit_altitude = m;` instead of `= "m";`), which does not compile -- it broke the whole
// idl_types target and therefore viss-server. The annotations are documentation-only
// metadata: the wire format, the field order and the type name are all unchanged without
// them, so removing them costs nothing a consumer can observe. Units for these fields are
// the ROS 2 standard ones (degrees / m / m^2 / rad) and are handled at the mapping layer
// in src/providers/DDSProvider.cpp.
// generated from rosidl_adapter/resource/msg.idl.em
// with input from sensor_msgs/msg/NavSatFix.msg
// generated code does not contain a copyright notice

#include "NavSatStatus.idl"
#include "std_msgs/msg/Header.idl"

module sensor_msgs {
  module msg {
    typedef double double__9[9];
    module NavSatFix_Constants {
      const uint8 COVARIANCE_TYPE_UNKNOWN = 0;
      const uint8 COVARIANCE_TYPE_APPROXIMATED = 1;
      const uint8 COVARIANCE_TYPE_DIAGONAL_KNOWN = 2;
      const uint8 COVARIANCE_TYPE_KNOWN = 3;
    };
    struct NavSatFix {
      std_msgs::msg::Header header;
      sensor_msgs::msg::NavSatStatus status;
      double latitude;
      double longitude;
      double altitude;
      double__9 position_covariance;

      uint8 position_covariance_type;
    };
  };
};
