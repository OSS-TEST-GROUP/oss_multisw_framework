#!/bin/sh

STATE_DIR="${ADSW_TEST_DOCKER_STATE_DIR:-/tmp/adsw_test_docker_state}"
LOG="${ADSW_TEST_DOCKER_LOG:-/tmp/adsw_test_docker.log}"
mkdir -p "$STATE_DIR"

log() {
  {
    printf 'docker'
    for arg in "$@"; do printf ' %s' "$arg"; done
    printf '\n'
  } >> "$LOG"
}

exists_file() { echo "$STATE_DIR/exists_$1"; }
running_file() { echo "$STATE_DIR/running_$1"; }

# Optional: force failures by env (for branch tests)
# ADSW_TEST_DOCKER_FAIL="start|run|stop|inspect|container_inspect|version"
should_fail() {
  echo "${ADSW_TEST_DOCKER_FAIL:-}" | tr '|' '\n' | grep -qx "$1"
}

log "$@"

# docker --version
if [ "$1" = "--version" ] || [ "$1" = "version" ]; then
  if should_fail version; then exit 1; fi
  echo "Docker version 99.0.0, build teststub"
  exit 0
fi

# docker container inspect <name>
if [ "$1" = "container" ] && [ "$2" = "inspect" ]; then
  name="$3"
  if should_fail container_inspect; then exit 1; fi
  if [ -f "$(exists_file "$name")" ]; then
    echo "[]"
    exit 0
  fi
  echo "Error: No such container: $name" 1>&2
  exit 1
fi

# docker inspect -f '{{.State.Running}}' <name>
if [ "$1" = "inspect" ] && [ "$2" = "-f" ]; then
  fmt="$3"
  name="$4"
  if should_fail inspect; then exit 1; fi

  if [ ! -f "$(exists_file "$name")" ]; then
    echo "Error: No such container: $name" 1>&2
    exit 1
  fi

  # only handle Running format used by AppController
  if [ -f "$(running_file "$name")" ]; then
    echo "true"
  else
    echo "false"
  fi
  exit 0
fi

# docker start <name>
if [ "$1" = "start" ]; then
  name="$2"
  if should_fail start; then exit 1; fi
  if [ ! -f "$(exists_file "$name")" ]; then
    echo "Error: No such container: $name" 1>&2
    exit 1
  fi
  : > "$(running_file "$name")"
  echo "$name"
  exit 0
fi

# docker stop <name>
if [ "$1" = "stop" ]; then
  name="$2"
  if should_fail stop; then exit 1; fi
  if [ ! -f "$(exists_file "$name")" ]; then
    echo "Error: No such container: $name" 1>&2
    exit 1
  fi
  rm -f "$(running_file "$name")"
  echo "$name"
  exit 0
fi

# docker run -d --name <name> ... <image>
if [ "$1" = "run" ]; then
  if should_fail run; then exit 1; fi

  # find --name
  name=""
  i=1
  while [ $i -le $# ]; do
    eval arg=\${$i}
    if [ "$arg" = "--name" ]; then
      j=$((i+1))
      eval name=\${$j}
      break
    fi
    i=$((i+1))
  done

  if [ -z "$name" ]; then
    echo "Error: --name missing" 1>&2
    exit 1
  fi

  : > "$(exists_file "$name")"
  : > "$(running_file "$name")"
  echo "stubcontainerid-$name"
  exit 0
fi

echo "Error: unsupported docker stub args: $*" 1>&2
exit 2