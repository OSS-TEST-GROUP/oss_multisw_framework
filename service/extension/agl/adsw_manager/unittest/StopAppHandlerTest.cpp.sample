// StopAppHandlerTest.cpp
#include <gtest/gtest.h>
#include <gmock/gmock.h>

#include <atomic>
#include <condition_variable>
#include <mutex>
#include <thread>
#include <chrono>

#include <fastdds/dds/domain/DomainParticipantFactory.hpp>
#include <fastdds/dds/domain/DomainParticipant.hpp>
#include <fastdds/dds/publisher/Publisher.hpp>
#include <fastdds/dds/publisher/DataWriter.hpp>
#include <fastdds/dds/publisher/qos/PublisherQos.hpp>
#include <fastdds/dds/publisher/qos/DataWriterQos.hpp>
#include <fastdds/dds/subscriber/Subscriber.hpp>
#include <fastdds/dds/subscriber/DataReader.hpp>
#include <fastdds/dds/subscriber/qos/SubscriberQos.hpp>
#include <fastdds/dds/subscriber/qos/DataReaderQos.hpp>
#include <fastdds/dds/core/status/SubscriptionMatchedStatus.hpp>
#include <fastdds/dds/core/status/PublicationMatchedStatus.hpp>
#include <fastdds/dds/topic/Topic.hpp>
#include <fastdds/dds/topic/TypeSupport.hpp>
#include <fastdds/dds/core/status/StatusMask.hpp>
#include <fastdds/dds/core/ReturnCode.hpp>

#include "StopAppHandler.hpp"
#include "agl/StopAppRequestPubSubTypes.hpp"
#include "agl/StopAppResponsePubSubTypes.hpp"

using namespace eprosima::fastdds::dds;
using namespace adsw_manager::agl;
using namespace adsw_manager_agl;

static constexpr const char* kReqTopic = "mmf/lifecyclemgr/StopAppRequest";
static constexpr const char* kResTopic = "mmf/lifecyclemgr/StopAppResponse";

// ---------- DDS helpers ----------
struct DdsBundle {
    DomainParticipant* participant{nullptr};
    Publisher* publisher{nullptr};
    Subscriber* subscriber{nullptr};
};

static DdsBundle MakeDefaultDds(bool autoenable = true)
{
    auto* factory = DomainParticipantFactory::get_instance();

    DomainParticipantFactoryQos fqos;
    factory->get_qos(fqos);
    // 최신 Fast DDS는 함수형 접근
    fqos.entity_factory().autoenable_created_entities = autoenable;
    factory->set_qos(fqos);

    DomainParticipantQos pqos = PARTICIPANT_QOS_DEFAULT;
    auto* participant = factory->create_participant(0, pqos);
    EXPECT_NE(participant, nullptr);

    auto* pub = participant->create_publisher(PUBLISHER_QOS_DEFAULT, nullptr);
    auto* sub = participant->create_subscriber(SUBSCRIBER_QOS_DEFAULT, nullptr);
    EXPECT_NE(pub, nullptr);
    EXPECT_NE(sub, nullptr);

    return {participant, pub, sub};
}

static void DestroyDds(DdsBundle& d)
{
    if (!d.participant) return;
    d.participant->delete_contained_entities();
    DomainParticipantFactory::get_instance()->delete_participant(d.participant);
    d.participant = nullptr;
    d.publisher = nullptr;
    d.subscriber = nullptr;
}

// ---------- Matching wait helpers ----------
static bool WaitWriterMatched(DataWriter* w,
                              int min_count = 1,
                              std::chrono::milliseconds timeout = std::chrono::seconds(10))
{
    PublicationMatchedStatus st{};
    auto deadline = std::chrono::steady_clock::now() + timeout;
    while (std::chrono::steady_clock::now() < deadline) {
        if (w->get_publication_matched_status(st) == RETCODE_OK) {
            if (st.current_count >= min_count) return true;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(20));
    }
    return false;
}

static bool WaitReaderMatched(DataReader* r,
                              int min_count = 1,
                              std::chrono::milliseconds timeout = std::chrono::seconds(10))
{
    SubscriptionMatchedStatus st{};
    auto deadline = std::chrono::steady_clock::now() + timeout;
    while (std::chrono::steady_clock::now() < deadline) {
        if (r->get_subscription_matched_status(st) == RETCODE_OK) {
            if (st.current_count >= min_count) return true;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(20));
    }
    return false;
}

// ---------- Tests ----------

TEST(StopAppHandler_Integration, Initialize_And_Receive_Request_And_Publish_Response)
{
    // A: StopAppHandler가 붙을 참가자
    auto ddsA = MakeDefaultDds(/*autoenable=*/true);
    // B: 테스트에서 요청 publish / 응답 subscribe 할 별도 참가자 (토픽 충돌 방지)
    auto ddsB = MakeDefaultDds(/*autoenable=*/true);

    std::atomic<int> cb_called{0};
    std::mutex m;
    std::condition_variable cv;

    {
        // handler는 스코프 안에 두어 먼저 소멸시키고, 그 다음 participant 정리
        StopAppHandler handler;

        auto cb = [&](const StopAppRequest& /*req*/) {
            cb_called.fetch_add(1);
            cv.notify_all();
        };

        ASSERT_TRUE(handler.Initialize(ddsA.participant, ddsA.publisher, ddsA.subscriber, cb));

        // B 참가자 쪽: 요청 publisher, 응답 reader 준비
        TypeSupport req_type(new StopAppRequestPubSubType());
        ASSERT_EQ(req_type.register_type(ddsB.participant), RETCODE_OK);
        Topic* req_topicB = ddsB.participant->create_topic(kReqTopic, req_type.get_type_name(), TOPIC_QOS_DEFAULT);
        ASSERT_NE(req_topicB, nullptr);
        DataWriter* req_writerB = ddsB.publisher->create_datawriter(req_topicB, DATAWRITER_QOS_DEFAULT, nullptr);
        ASSERT_NE(req_writerB, nullptr);

        TypeSupport res_type(new StopAppResponsePubSubType());
        ASSERT_EQ(res_type.register_type(ddsB.participant), RETCODE_OK);
        Topic* res_topicB = ddsB.participant->create_topic(kResTopic, res_type.get_type_name(), TOPIC_QOS_DEFAULT);
        ASSERT_NE(res_topicB, nullptr);
        DataReader* res_readerB = ddsB.subscriber->create_datareader(res_topicB, DATAREADER_QOS_DEFAULT, nullptr);
        ASSERT_NE(res_readerB, nullptr);

        // --- 매칭 대기 (중요!) ---
        // 요청 경로: B의 writer ↔ A의 reader
        ASSERT_TRUE(WaitWriterMatched(req_writerB, /*min_count=*/1, std::chrono::seconds(10)))
            << "Request writer did not match a reader in time";

        // 응답 경로: A의 writer ↔ B의 reader
        ASSERT_TRUE(WaitReaderMatched(res_readerB, /*min_count=*/1, std::chrono::seconds(10)))
            << "Response reader did not match a writer in time";

        // 1) 요청 publish → A의 핸들러 리더가 수신 → 콜백 호출
        StopAppRequest req;
        ASSERT_EQ(req_writerB->write(&req), RETCODE_OK);

        {
            std::unique_lock<std::mutex> lk(m);
            // 콜백 기다림
            ASSERT_TRUE(cv.wait_for(lk, std::chrono::seconds(5), [&]{ return cb_called.load() >= 1; }))
                << "Callback not called after publishing request";
        }

        // 2) A의 핸들러가 응답 publish → B의 리더로 수신 확인
        StopAppResponse resp;
        resp.ret_code(ReturnCode::SUCCESS);
        ASSERT_TRUE(handler.PublishResponse(resp));

        StopAppResponse got;
        SampleInfo info;
        bool received = false;
        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
        while (std::chrono::steady_clock::now() < deadline) {
            if (res_readerB->take_next_sample(&got, &info) == RETCODE_OK && info.valid_data) {
                received = true;
                break;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(10));
        }
        EXPECT_TRUE(received) << "Did not receive StopAppResponse";
    } // handler 소멸(자체적으로 엔티티 정리)

    // 참가자 정리 (이중 삭제 방지)
    DestroyDds(ddsA);
    DestroyDds(ddsB);
}

TEST(StopAppHandler_Integration, PublishResponse_Fails_When_Writer_NotEnabled)
{
    // auto-enable 비활성화 → writer/reader가 enable 되지 않은 상태 유도
    auto dds = MakeDefaultDds(/*autoenable=*/false);

    {
        StopAppHandler handler;
        auto cb = [](const StopAppRequest&){};
        ASSERT_TRUE(handler.Initialize(dds.participant, dds.publisher, dds.subscriber, cb));

        StopAppResponse resp;
        // 비활성 writer에서 write() → 실패 코드 기대 → PublishResponse() == false
        bool ok = handler.PublishResponse(resp);
        EXPECT_FALSE(ok);
    } // handler 먼저 파괴

    DestroyDds(dds);
}
