<?xml version="1.0" encoding="UTF-8"?>
<fmiModelDescription
    fmiVersion="2.0"
    modelName="BrakeVehicle"
    guid="{b1a4e0de-0000-4000-8000-6272616b6501}"
    description="First-order longitudinal brake vehicle plant (SiLS example)"
    generationTool="hand-written FMI 2.0 co-sim example"
    numberOfEventIndicators="0">

  <CoSimulation
      modelIdentifier="brake_vehicle"
      canHandleVariableCommunicationStepSize="true"
      canGetAndSetFMUstate="false"
      canSerializeFMUstate="false"/>

  <!-- Value references map to the ECU's env: force=1 -> SILS_FMU_INPUT_VR,
       speed=0 -> SILS_FMU_OUTPUT_VR. Initial speed (30 m/s) is the output start
       value; FmuPlant reads it after init (its Reset is a no-op), so on the FMU
       path SILS_PLANT_INIT does not apply. NOTE: no comment may precede the root
       element above -- fmi4c's ezxml parser fails to read the root's attributes if
       one does (see models/brake-fmu/README.md). Body comments like this are fine. -->
  <ModelVariables>
    <!-- index 1 -->
    <ScalarVariable name="speed" valueReference="0" causality="output"
                    variability="continuous" initial="exact">
      <Real start="30.0"/>
    </ScalarVariable>
    <!-- index 2 -->
    <ScalarVariable name="force" valueReference="1" causality="input"
                    variability="continuous">
      <Real start="0.0"/>
    </ScalarVariable>
  </ModelVariables>

  <ModelStructure>
    <Outputs>
      <Unknown index="1"/>
    </Outputs>
    <InitialUnknowns>
      <Unknown index="1"/>
    </InitialUnknowns>
  </ModelStructure>

</fmiModelDescription>
