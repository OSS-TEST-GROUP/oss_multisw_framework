pipeline {
    agent {
        label 'OSS-Agent'
    }

    parameters {
        string(name: 'GIT_BRANCH', defaultValue: 'develop', description: 'branch')
    }

    environment {
        // Agent Node
        AGENT_LABEL="OSS-Agent"

        // Docker Registry
        IMAGE_REGISTRY = "registry.obigo.com"
        IMAGE_NAMESPACE = "oss"
        APP_NAME = "oss-mmf"
        // Harbor 자격증명은 Jenkins Credentials(Username with password)에서 주입한다.
        // 저장소에 비밀번호를 하드코딩하지 않는다 (공개 저장소로 전달되는 파일).
        // 등록 대상: Harbor 로봇 계정 oss-ci (pull+push, oss 프로젝트 한정)
        //   → REGISTRY_USR / REGISTRY_PSW 환경변수가 자동 생성되고 로그에서 마스킹된다.
        REGISTRY = credentials('harbor-oss-ci')

        // Dockerfile Path
        DOCKERFILE_PATH = "docker/Dockerfile" 
        // Docker images
        BUILDER_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-builder:latest"
        //RUNTIME_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}"
        //ANALYSIS_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-analysis"
        //DEBUG_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-debug" 

        // Docker Buildx
        DOCKER_BUILDKIT = '1'
        BUILDX_BUILDER_NAME = 'multiarch-builder'
        
        // Multi Architecture
        PLATFORM_AMD64 = 'linux/amd64'
        PLATFORM_ARM64 = 'linux/arm64'
        PLATFORMS_ALL = 'linux/amd64,linux/arm64'

        // Project
        BUILD_UNITTEST = 'TRUE'
        EXTENSION_PLATFORM = 'ROS2'
        
        // Credentials
        GITHUB_CREDENTIALS = 'github-cred'
        GITLAB_CREDENTIALS = 'brian.doh'
        REGISTRY_CREDENTIALS = 'Harbor_Jenkins'
        
        GITHUB_REPO_URL = 'https://github.com/obigo-gov/oss_multisw_framework.git'
        GITOPS_REPO_URL = 'https://lotte-autops.com/oss_group1/oss_multisw_framework.git'
        TARGET_BRANCH = "${params.GIT_BRANCH}"

        // Sysroot
        SDK_DIR="${HOME}/obigo-sdk"
        //SYSROOT_DIR = "${SDK_DIR}/sysroot-aarch64"
        //TOOLCHAIN_FILE = "${SDK_DIR}/toolchain-aarch64.cmake"
        
        TEST_RESULT = 'SUCCESS'
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Login Registry') {
            steps {
                script {
                    echo "Login Docker Private Registry. If registry didn't saved"
                    sh '''
                        if cat ${HOME}/.docker/config.json 2>/dev/null | grep "${IMAGE_REGISTRY}:80"; then
                            docker logout "${IMAGE_REGISTRY}:80"
                        fi
                        if ! cat ${HOME}/.docker/config.json 2>/dev/null | grep "${IMAGE_REGISTRY}"; then
                            # 로봇 계정명에 '$' 가 포함되므로(robot$oss+oss-ci) 반드시 변수 참조로 넘긴다.
                            printf '%s' "${REGISTRY_PSW}" | docker login "${IMAGE_REGISTRY}" -u "${REGISTRY_USR}" --password-stdin
                        fi
                    '''
                }
            }
        }
        stage('Sync Sources') {
            steps {
                echo "Checking out source code..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${TARGET_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: "${GITHUB_REPO_URL}",
                        credentialsId: "${GITHUB_CREDENTIALS}"
                    ]]
                ])
                // Tag
                script {
                    env.COMMIT_HASH = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.IMAGE_TAG = "${BUILD_NUMBER}-${COMMIT_HASH}"
                    env.BUILD_DATE = sh(script: "date -u +'%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
                    env.BRANCH_CLEAN = sh(script: "echo ${TARGET_BRANCH} | sed 's/[^a-zA-Z0-9._-]/-/g'", returnStdout: true).trim()
                }
                // Dependency library - FastDDS
                script {
                    sh '''
                        if [ ! -d ${SDK_DIR}/Fast-DDS ]; then
                            if [ ! -d ${SDK_DIR}/venv ]; then
                                python3 -m venv ${SDK_DIR}/venv
                            fi
                            . ${SDK_DIR}/venv/bin/activate
                            if [ -z $(which vcs) ]; then
                                pip3 install --no-cache-dir \
                                    colcon-common-extensions \
                                    vcstool \
                                    >/dev/null 2>&1
                            fi
                            
                            mkdir -p ${SDK_DIR}/Fast-DDS/src
                            pushd ${SDK_DIR}/Fast-DDS >/dev/null 2>&1
                            cd ${SDK_DIR}/Fast-DDS
                            wget https://raw.githubusercontent.com/eProsima/Fast-DDS/3.2.2/fastdds.repos
                            vcs import src < fastdds.repos
                            sed -i "s#-Wpedantic##g" ${SDK_DIR}/Fast-DDS/src/fastdds/CMakeLists.txt
                            deactivate
                        fi
                    '''
                }
            }
        }
        stage('Pull Builder Container') {
            steps {
                script {
                    sh '''
                        #!/bin/bash
                        set -e
                        if ! curl -u "${REGISTRY_USR}:${REGISTRY_PSW}" -s https://${IMAGE_REGISTRY}/v2/_catalog 2>/dev/null \
                            | grep -q "${APP_NAME}-builder"; then
                            docker build -t ${BUILDER_IMAGE} \
                                -f ${PWD}/docker/Dockerfile .
                            # push 는 Harbor 로봇 계정(oss-ci) 자격증명으로 수행.
                            printf '%s' "${REGISTRY_PSW}" | docker login "${IMAGE_REGISTRY}" -u "${REGISTRY_USR}" --password-stdin
                            docker push ${BUILDER_IMAGE}
                        else
                            if [ -z $(docker images -q "${BUILDER_IMAGE}") ]; then
                                docker pull ${BUILDER_IMAGE}
                            fi
                        fi
                    '''
                }
                // Build Fast-DDS for x86_64 indisde builder
                script {
                   if (!fileExists("${SDK_DIR}/Fast-DDS/output")) {
                       docker.image("${BUILDER_IMAGE}").inside('-u 1000:1000 -v ${SDK_DIR}:/opt') {
                           sh '''
                               #!/bin/bash
                               set -e
                               cd /opt/Fast-DDS
                               colcon build \
                                   --merge-install \
                                   --parallel-workers $(nproc) \
                                   --build-base build/ros2_x86_64 \
                                   --install-base output/ros2_x86_64
                           '''
                       }
                    }
                }
            }
        }
        stage('Build for x86_64') {
            steps {
                script {
                    sh '''
                        bash -c '
                            mkdir -p ${WORKSPACE}/output
                            mkdir -p ${WORKSPACE}/.build
                        '
                    '''
                    def dockerArgs = [
                    '-u 1000:1000',
                    '-w /home/ossuser/workspace',
                    "-e BUILD_MODE=Debug",
                    "-v ${SDK_DIR}:/opt",
                    "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                    "-v ${WORKSPACE}/docker/scripts/build.sh:/home/ossuser/workspace/build.sh",
                    "-v ${WORKSPACE}/CMakeLists.txt:/home/ossuser/workspace/CMakeLists.txt",
                    "-v ${WORKSPACE}/idl:/home/ossuser/workspace/idl",
                    "-v ${WORKSPACE}/service:/home/ossuser/workspace/service",
                    "-v ${WORKSPACE}/output:/home/ossuser/workspace/output"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            bash -c '
                                set -e
                                cd /home/ossuser/workspace
                                ./build.sh --build-unittest
                            '
                        '''
                    }
                }
            }
        }
        stage('Run Unittest') {
            steps {
                // Build the lightweight autoware mock image on the Jenkins agent host
                // BEFORE launching the builder container. The mock is used by the 9
                // autoware E2E tests (LifecycleAutoware*E2ETest) which now run in the
                // unit lane via fast-skip when prerequisites are absent.
                // ~760MB build; skipped if the image tag already exists.
                sh '''
                    if ! docker image inspect mmf-autoware-mock:humble >/dev/null 2>&1; then
                        echo "[unittest] Building autoware mock image (760MB)..."
                        docker build -f docker/test/Dockerfile.autoware-mock \
                            -t mmf-autoware-mock:humble .
                    else
                        echo "[unittest] mmf-autoware-mock:humble already exists, skipping build."
                    fi
                '''
                script {
                    def dockerArgs = [
                        '--network=host',
                        '-u 1000:1000',
                        '-w /home/ossuser/workspace',
                        '-e JAVA_OPTS=-Dorg.jenkinsci.plugins.durabletask.BourneShellScript.HEARTBEAT_CHECK_INTERVAL=86400',
                        // ── Autoware E2E: docker-in-container wiring ──────────────────
                        // Mount the host docker socket so the test runner container can
                        // manage docker containers (start/stop the mock image) on behalf
                        // of the autoware E2E tests.
                        // TODO (CI infra): ensure the ossuser (uid 1000) is in the
                        //   `docker` group on the Jenkins agent so it can use the socket.
                        //   Add to agent setup: usermod -aG docker ossuser
                        '-v /var/run/docker.sock:/var/run/docker.sock',
                        // ── Autoware E2E: path / image env vars ──────────────────────
                        // MMF_E2E_ROOT: top-level repo root as seen inside the runner.
                        // MMF_E2E_OUTPUT: where the build artifacts (binaries/libs) are.
                        // MMF_AUTOWARE_TEST_IMAGE: the mock image built above.
                        // MMF_E2E_FASTDDS_LIB: path to FastDDS SDK libs inside runner.
                        '-e MMF_E2E_ROOT=/home/ossuser/workspace',
                        '-e MMF_E2E_OUTPUT=/home/ossuser/workspace/output/x86_64/Debug',
                        '-e MMF_AUTOWARE_TEST_IMAGE=mmf-autoware-mock:humble',
                        '-e MMF_E2E_FASTDDS_LIB=/opt/Fast-DDS/output/ros2_x86_64/lib',
                        "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                        "-v ${WORKSPACE}/idl:/home/ossuser/workspace/idl",
                        "-v ${WORKSPACE}/output:/home/ossuser/workspace/output",
                        "-v ${WORKSPACE}/service:/home/ossuser/workspace/service",
                        "-v ${WORKSPACE}/docker:/home/ossuser/workspace/docker",
                        "-v ${WORKSPACE}/docker/scripts/run_unittest.sh:/home/ossuser/workspace/run_unittest.sh",
                        // run_unittest.sh reads docker/scripts/integration-tests.regex to
                        // exclude the runtime-dependent integration tests. The script is
                        // mounted standalone at the workspace root, so without ALSO mounting
                        // the regex next to it INTEGRATION_RE comes back empty and every
                        // integration test runs (and fails) in the unit lane. Mount it at the
                        // path the script probes first.
                        "-v ${WORKSPACE}/docker/scripts/integration-tests.regex:/home/ossuser/workspace/docker/scripts/integration-tests.regex"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            bash -c '
                                cd /home/ossuser/workspace
                                ./run_unittest.sh
                            '
                        '''
                    }
                }
                script {
                    def res
                    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                        res = junit(testResults: 'output/unittest-results/**/*.xml', allowEmptyResults: true)
                    }

                    def total   = res?.totalCount  ?: 0
                    def failed  = res?.failCount   ?: 0
                    def skipped = res?.skipCount   ?: 0
                    def passed  = (res?.passCount != null) ? res.passCount : (total - failed - skipped)
                    def runTotal = Math.max(total - skipped, 0)
                    def successRateRun     = runTotal > 0 ? (passed * 100.0 / runTotal) : 0.0
                    def successRateOverall = total    > 0 ? (passed * 100.0 / total)    : 0.0

                    echo """[JUnit DEBUG]
                        total   = ${total}
                        failed  = ${failed}
                        skipped = ${skipped}
                        passed  = ${passed}
                        runTotal(=total - skipped) = ${runTotal}
                        successRate(run only)      = ${String.format('%.2f', successRateRun)}%
                        successRate(overall)       = ${String.format('%.2f', successRateOverall)}%
                    """

                    def successRate = successRateRun
                    env.TEST_RESULT = (successRate < 50.0) ? 'UNSTABLE' : 'SUCCESS'
                    currentBuild.result = env.TEST_RESULT
                    currentBuild.description = "T:${total} P:${passed} F:${failed} S:${skipped} ✓${String.format('%.1f', successRate)}%"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'output/unittest-results/**/junit_results.xml', fingerprint: true
                }
            }
        }
        // ── 통합 레인 (커버리지 캡처 전에 실행) ──────────────────────────────
        //
        // 왜 여기인가:
        //   integration-tests.regex 로 유닛 레인에서 빠진 테스트들 —
        //   ConcreteEndpointIntegrationTest(lifecycle 21 / adsw 13),
        //   LifecycleAdswIntegrationTest 10, ContainerDockerComposeTest 4,
        //   ROSDiscoveryInfoEndpointTest 3 — 은 실제로 프로덕션 코드를
        //   실행하지만 .gcda 를 남기지 않아 커버리지에 한 줄도 기여하지
        //   못했다. 그래서 adsw 의 Start/Stop/GetServiceState/
        //   UpdateServiceList 엔드포인트가 "테스트 없음"처럼 60%대로 찍힌다.
        //   실제로는 실 DDS pub→sub 로 검증되고 있다.
        //
        //   Jenkinsfile.integration 에 붙일 수는 없다. 그 파이프라인은
        //   BUILD_UNITTEST=FALSE 로 빌드해서 --coverage 계측이 없고,
        //   애초에 이 ctest 타겟들이 BUILD_UNITTEST 아래에서만 등록되므로
        //   빌드조차 되지 않는다. 계측 빌드를 가진 파이프라인은 여기뿐이다.
        //
        //   coverage.sh 는 레인 구분 없이 빌드 트리의 .gcda 를 통째로
        //   캡처하므로, 순서만 Coverage 앞에 두면 된다.
        //
        // 실패는 빌드를 깨지 않는다 (run_integration.sh 가 `|| true`).
        // 도메인은 유닛 레인/컴포즈 스택과 겹치지 않게 고정한다.
        stage('Integration ctest (for coverage)') {
            steps {
                script {
                    def dockerArgs = [
                        '-u 1000:1000',
                        '-w /home/ossuser/workspace',
                        "-v ${SDK_DIR}:/opt",
                        "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                        "-v ${WORKSPACE}/idl:/home/ossuser/workspace/idl",
                        "-v ${WORKSPACE}/output:/home/ossuser/workspace/output",
                        "-v ${WORKSPACE}/service:/home/ossuser/workspace/service",
                        "-v ${WORKSPACE}/docker:/home/ossuser/workspace/docker"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            cd /home/ossuser/workspace
                            MMF_INTEGRATION_DOMAIN=137 CTEST_TIMEOUT=60 \
                                bash docker/scripts/run_integration.sh
                        '''
                    }
                }
            }
            post {
                always {
                    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                        junit testResults: 'output/integration-results/**/*.xml', allowEmptyResults: true
                    }
                    archiveArtifacts artifacts: 'output/integration-results/**/junit_results.xml',
                                     allowEmptyArchive: true, fingerprint: true
                }
            }
        }
        stage('Coverage') {
            steps {
                script {
                    def dockerArgs = [
                        '--network=host',
                        '-u 1000:1000',
                        '-w /home/ossuser/workspace',
                        "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                        "-v ${WORKSPACE}/service:/home/ossuser/workspace/service",
                        "-v ${WORKSPACE}/output:/home/ossuser/workspace/output",
                        "-v ${WORKSPACE}/docker/scripts/coverage.sh:/home/ossuser/workspace/coverage.sh"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            bash -c '
                                cd /home/ossuser/workspace
                                ./coverage.sh
                            '
                        '''
                    }
                }
            }
            post {
                always {
                    recordCoverage(
                        name: 'Multi-Middleware Coverage',
                        id: 'oss-coverage',
                        tools: [[
                            parser: 'COBERTURA',
                            pattern: 'output/coverage/coverage.xml'
                        ]],
                        sourceCodeRetention: 'EVERY_BUILD',
                        failOnError: false
                    )

                    publishHTML(target:[
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'output/coverage/report',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])

                    archiveArtifacts artifacts: '''
                        output/coverage/filtered.info,
                        output/coverage/coverage.xml
                    '''.stripIndent().trim(), fingerprint: true, allowEmptyArchive: true
                }
            }
        }
    }
    post {
        always {
            echo "Cleaning workspace after all stages..."
            sh 'git clean -fdx || true'
            cleanWs(deleteDirs: true, notFailBuild: true, disableDeferredWipeout: true)
        }
    }
}
