pipeline {
    agent {
        label 'OSS-Agent'
    }

    environment {
        // Agent Node
        AGENT_LABEL="OSS-Agent"

        // Docker Registry
        IMAGE_REGISTRY = "registry.obigo.com"
        IMAGE_NAMESPACE = "oss"
        APP_NAME = "oss-mmf"
        REGISTRY_ID = "builder"
        REGISTRY_PWD = "Obigoam1@se"

        // Dockerfile Path
        DOCKERFILE_PATH = "docker/Dockerfile" 
        // Docker images
        BUILDER_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-builder:latest"
        //RUNTIME_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}"
        //ANALYSIS_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-analysis"
        //DEBUG_IMAGE = "${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/${APP_NAME}-debug" 

        // Docker Buildx
        DOCKER_BUILDKIT = '1'
        BUILDX_BUILDER_NAME = 'multiarch-builder'
        
        // Multi Architecture
        PLATFORM_AMD64 = 'linux/amd64'
        PLATFORM_ARM64 = 'linux/arm64'
        PLATFORMS_ALL = 'linux/amd64,linux/arm64'

        // Project
        BUILD_UNITTEST = 'TRUE'
        EXTENSION_PLATFORM = 'ROS2'
        
        // Credentials
        GITHUB_CREDENTIALS = 'github-cred'
        GITLAB_CREDENTIALS = 'brian.doh'
        REGISTRY_CREDENTIALS = 'Harbor_Jenkins'
        
        GITHUB_REPO_URL = 'https://github.com/obigo-gov/oss_multisw_framework.git'
        GITOPS_REPO_URL = 'https://lotte-autops.com/oss_group1/oss_multisw_framework.git'
        GIT_BRANCH = "develop"

        // Sysroot
        SDK_DIR="${HOME}/obigo-sdk"
        //SYSROOT_DIR = "${SDK_DIR}/sysroot-aarch64"
        //TOOLCHAIN_FILE = "${SDK_DIR}/toolchain-aarch64.cmake"
    }

   options {
        timeout(time: 120, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Login Registry') {
            steps {
                script {
                    echo "Login Docker Private Registry. If registry didn't saved"
                    sh '''
                        if cat ${HOME}/.docker/config.json | grep "${IMAGE_REGISTRY}:80"; then
                            docker logout "${IMAGE_REGISTRY}:80"
                        fi
                        if ! cat ${HOME}/.docker/config.json | grep "${IMAGE_REGISTRY}"; then
                            echo "${REGISTRY_PWD}" | docker login ${IMAGE_REGISTRY} -u ${REGISTRY_ID} --password-stdin
                        fi
                    '''
                }
            }
        }
        stage('Sync Sources') {
            steps {
                echo "Checking out source code..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: "${GITHUB_REPO_URL}",
                        credentialsId: "${GITHUB_CREDENTIALS}"
                    ]]
                ])
                // Tag
                script {
                    env.COMMIT_HASH = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.IMAGE_TAG = "${BUILD_NUMBER}-${COMMIT_HASH}"
                    env.BUILD_DATE = sh(script: "date -u +'%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
                    env.BRANCH_CLEAN = sh(script: "echo ${GIT_BRANCH} | sed 's/[^a-zA-Z0-9._-]/-/g'", returnStdout: true).trim()
                }
                // Dependency library - FastDDS
                script {
                    sh '''
                        if [ ! -d ${SDK_DIR}/Fast-DDS ]; then
                            if [ ! -d ${SDK_DIR}/venv ]; then
                                python3 -m venv ${SDK_DIR}/venv
                            fi
                            . ${SDK_DIR}/venv/bin/activate
                            if [ -z $(which vcs) ]; then
                                pip3 install --no-cache-dir \
                                    colcon-common-extensions \
                                    vcstool \
                                    >/dev/null 2>&1
                            fi
                            
                            mkdir -p ${SDK_DIR}/Fast-DDS/src
                            pushd ${SDK_DIR}/Fast-DDS >/dev/null 2>&1
                            cd ${SDK_DIR}/Fast-DDS
                            wget https://raw.githubusercontent.com/eProsima/Fast-DDS/3.2.2/fastdds.repos
                            vcs import src < fastdds.repos
                            sed -i "s#-Wpedantic##g" ${SDK_DIR}/Fast-DDS/src/fastdds/CMakeLists.txt
                            deactivate
                        fi
                    '''
                }
            }
        }
        stage('Pull Builder Container') {
            steps {
                script {
                    sh '''
                        #!/bin/bash
                        set -e
                        if ! curl -u "${REGISTRY_ID}:${REGISTRY_PWD}" -s https://${IMAGE_REGISTRY}/v2/_catalog 2>/dev/null \
                            | grep -q "${APP_NAME}-builder"; then
                            docker build -t ${BUILDER_IMAGE} \
                                -f ${PWD}/docker/Dockerfile .
                            docker push ${BUILDER_IMAGE}
                        else
                            if [ -z $(docker images -q "${BUILDER_IMAGE}") ]; then
                                docker pull ${BUILDER_IMAGE}
                            fi
                        fi
                    '''
                }
                // Build Fast-DDS for x86_64 indisde builder
                script {
                   if (!fileExists("${SDK_DIR}/Fast-DDS/output")) {
                       docker.image("${BUILDER_IMAGE}").inside('-u 1000:1000 -v ${SDK_DIR}:/opt') {
                           sh '''
                               #!/bin/bash
                               set -e
                               cd /opt/Fast-DDS
                               colcon build \
                                   --merge-install \
                                   --parallel-workers $(nproc) \
                                   --build-base build/ros2_x86_64 \
                                   --install-base output/ros2_x86_64
                           '''
                       }
                    }
                }
            }
        }
        stage('Build for x86_64') {
            steps {
                script {
                    sh '''
                        bash -c '
                            mkdir -p ${WORKSPACE}/output
                            mkdir -p ${WORKSPACE}/.build
                        '
                    '''
                    def dockerArgs = [
                    '-u 1000:1000',
                    '-w /home/ossuser/workspace',
                    "-e BUILD_MODE=Debug",
                    "-v ${SDK_DIR}:/opt",
                    "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                    "-v ${WORKSPACE}/docker/scripts/build.sh:/home/ossuser/workspace/build.sh",
                    "-v ${WORKSPACE}/CMakeLists.txt:/home/ossuser/workspace/CMakeLists.txt",
                    "-v ${WORKSPACE}/idl:/home/ossuser/workspace/idl",
                    "-v ${WORKSPACE}/service:/home/ossuser/workspace/service",
                    "-v ${WORKSPACE}/output:/home/ossuser/workspace/output"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            bash -c '
                                set -e
                                cd /home/ossuser/workspace
                                ./build.sh --build-unittest --set-extension-platform=ROS2
                            '
                        '''
                    }
                }
            }
        }
        stage('Run Unittest') {
            steps {
                script {
                    def dockerArgs = [
                        '--network=host',
                        '-u 1000:1000',
                        '-w /home/ossuser/workspace',
                        '-e JAVA_OPTS=-Dorg.jenkinsci.plugins.durabletask.BourneShellScript.HEARTBEAT_CHECK_INTERVAL=86400',
                        "-v ${WORKSPACE}/.build:/home/ossuser/workspace/.build",
                        "-v ${WORKSPACE}/idl:/home/ossuser/workspace/idl",
                        "-v ${WORKSPACE}/output:/home/ossuser/workspace/output",
                        "-v ${WORKSPACE}/docker/scripts/run_unittest.sh:/home/ossuser/workspace/run_unittest.sh"
                    ].join(' ')
                    docker.image("${BUILDER_IMAGE}").inside(dockerArgs) {
                        sh '''
                            bash -c '
                                cd /home/ossuser/workspace
                                ./run_unittest.sh
                            '
                        '''
                    }
                }
                script {
                    def result = junit allowEmptyResults: true, testResults: 'output/unittest-results/**/junit_results.xml'

                    def total   = res?.totalCount  ?: 0
                    def failed  = res?.failCount   ?: 0
                    def skipped = res?.skipCount   ?: 0
                    def passed  = (res?.passCount != null) ? res.passCount : (total - failed - skipped)
                    def runTotal = Math.max(total - skipped, 0)
                    def successRateRun     = runTotal > 0 ? (passed * 100.0 / runTotal) : 0.0
                    def successRateOverall = total    > 0 ? (passed * 100.0 / total)    : 0.0

                    echo """[JUnit DEBUG]
                        total   = ${total}
                        failed  = ${failed}
                        skipped = ${skipped}
                        passed  = ${passed}
                        runTotal(=total - skipped) = ${runTotal}
                        successRate(run only)      = ${String.format('%.2f', successRateRun)}%
                        successRate(overall)       = ${String.format('%.2f', successRateOverall)}%
                    """

                    def successRate = successRateRun   // 또는 successRateOverall
                    currentBuild.result = (successRate < 50.0) ? 'UNSTABLE' : 'SUCCESS'
                    currentBuild.description = "T:${total} P:${passed} F:${failed} S:${skipped} ✓${String.format('%.1f', successRate)}%"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'output/unittest-results/**/junit_results.xml', fingerprint: true
                }
            }
        }
    }
    post {
        always {
            echo "Cleaning workspace after all stages..."
            sh 'git clean -fdx || true'
            cleanWs(deleteDirs: true, notFailBuild: true, disableDeferredWipeout: true)
        }
    }
}
