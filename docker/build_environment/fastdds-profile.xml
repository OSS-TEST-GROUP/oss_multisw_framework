<?xml version="1.0" encoding="UTF-8" ?>
<profiles>
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="participant_with_udp_transport" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>

    <!-- Disable data sharing for all readers/writers — forces UDP delivery and avoids
         stale SHM segments from killed processes breaking writer proxy registration. -->
    <data_reader profile_name="default_datareader" is_default_profile="true">
        <qos>
            <data_sharing>
                <kind>OFF</kind>
            </data_sharing>
        </qos>
    </data_reader>

    <data_writer profile_name="default_datawriter" is_default_profile="true">
        <qos>
            <data_sharing>
                <kind>OFF</kind>
            </data_sharing>
        </qos>
    </data_writer>
</profiles>
