# Host Environment
# Ubuntu 22.04
# Docker Image Build to run on k3s container 
docker build -t ros2-hello:latest .
docker save ros2-hello:latest -o ros2-hello.tar



# Inside k3s + ROS2 Docker Environment
#docker run --privileged -it -p 6443:6443 ros2-k3s-dev:latest

docker run --privileged -it -p 6443:6443 --cgroupns=host -v ${HOME}/Project/OSS/oss_multisw_framework:/root/workspace -v /run/user/1000:/run/user/1000 -v /tmp/.X11-unix:/tmp/.X11-unix -e DISPLAY=unix:1 ros2-k3s-dev:latest bash


# In Docker Env
# This script is used to set up a K3s server in a Docker container for testing purposes.
# Install k3s for kubectl


curl -sfL https://get.k3s.io -o install_k3s.sh
chmod +x install_k3s.sh

#./install_k3s.sh --disable-agent --write-kubeconfig-mode 644
./install_k3s.sh --write-kubeconfig-mode 644
export INSTALL_K3S_SKIP_ENABLE=true

#/usr/local/bin/k3s server --disable-agent --write-kubeconfig-mode 644&
#k3s server --write-kubeconfig-mode 644 --snapshotter=fuse-overlayfs &
k3s server --write-kubeconfig-mode 644 --snapshotter=native &

kubectl get nodes

