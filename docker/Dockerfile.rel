###################################################################################
# Runtime
###################################################################################
FROM ubuntu:22.04 AS runtime

LABEL maintainer="Brian.doh <brian.doh@obigo.com>"
LABEL description="Runtime Image"
LABEL version="0.0.1"

# Set base environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

ENV TZ=Asia/Seoul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN sed -i 's|http://archive.ubuntu.com|http://mirror.kakao.com|g' /etc/apt/sources.list \
    && apt-get update && apt-get upgrade -y

RUN apt-get install -y --no-install-recommends \
    libtinyxml2-9 \
    libssl3 \
    libp11-3 \
    softhsm2 \
    libengine-pkcs11-openssl \
    libyaml-cpp0.7 \
    libgrpc++1 \
    libprotobuf23 \
    libprotobuf-c1 \
    grpc-proto \
    libcurl4 \
    nlohmann-json3-dev \
    cpp \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r -g 1000 ossuser \
    && useradd -r -u 1000 -g ossuser -d /oss -s /bin/bash ossuser \
    && mkdir -p /oss \
    && mkdir -p /oss/lib \
    && chown -R ossuser:ossuser /oss

COPY docker/build_environment/fastdds-profile.xml /oss/fastdds-profile.xml
ENV FASTDDS_DEFAULT_PROFILES_FILE=/oss/fastdds-profile.xml
ENV FASTDDS_LOG_LEVEL=Error

###################################################################################
# Core - x86_64
###################################################################################
FROM runtime AS runtime-mmf-core-x86_64

ARG BUILD_TYPE=Release

COPY --chown=ossuser:ossuser output/x86_64/${BUILD_TYPE}/core/bin /oss/bin
COPY --chown=ossuser:ossuser output/x86_64/lib /oss/lib
COPY --chown=ossuser:ossuser output/x86_64/${BUILD_TYPE}/core/lib /tmp/lib

# Generate unique machin_id
RUN if [ ! -s /etc/machine-id ]; then \
    echo "$(cat /proc/sys/kernel/random/uuid | tr -d '-')" > /etc/machine-id; \
    fi

WORKDIR /oss
USER ossuser

RUN cp -rpa /tmp/lib/*.so* /oss/lib/ \
    && rm -rf /tmp/lib

RUN sed -e "s#./#/oss/bin/#g" -i /oss/bin/config/config_middleware.yaml

ENV LD_LIBRARY_PATH=/oss/lib
ENV MMF_CONFIG_PATH=/oss/bin/config
ENV DIAG_CONFIG_PATH=/oss/bin/config
ENV VEHICLE_CONFIG_PATH=/oss/bin/config
ENV DIAG_IDL_PATH=/oss/bin/idl

ENTRYPOINT ["/oss/bin/lifecycle_mgr"]

###################################################################################
# Core - aarch64
###################################################################################
FROM runtime AS runtime-mmf-core-aarch64

ARG BUILD_TYPE=Release

COPY --chown=ossuser:ossuser output/aarch64/${BUILD_TYPE}/core/bin /oss/bin
COPY --chown=ossuser:ossuser output/aarch64/lib /oss/lib
COPY --chown=ossuser:ossuser output/aarch64/${BUILD_TYPE}/core/lib /tmp/lib

# Generate unique machin_id
RUN if [ ! -s /etc/machine-id ]; then \
    echo "$(cat /proc/sys/kernel/random/uuid | tr -d '-')" > /etc/machine-id; \
    fi

WORKDIR /oss
USER ossuser

RUN cp -rpa /tmp/lib/*.so* /oss/lib/ \
    && rm -rf /tmp/lib

RUN sed -e "s#./#/oss/bin/#g" -i /oss/bin/config/config_middleware.yaml

ENV LD_LIBRARY_PATH=/oss/lib
ENV MMF_CONFIG_PATH=/oss/bin/config
ENV DIAG_CONFIG_PATH=/oss/bin/config
ENV VEHICLE_CONFIG_PATH=/oss/bin/config
ENV DIAG_IDL_PATH=/oss/bin/idl

ENTRYPOINT ["/oss/bin/lifecycle_mgr"]

###################################################################################
# Core - Multi-arch selector
###################################################################################
FROM runtime-mmf-core-${TARGETARCH} AS runtime-mmf-core

###################################################################################
# Extension ROS2 - x86_64
###################################################################################
FROM runtime AS runtime-mmf-ext-ros2-x86_64

ARG BUILD_TYPE=Release

# Install ROS2 Humble and rosbridge-server
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg2 \
    lsb-release \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ros-humble-rosbridge-server \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=ossuser:ossuser docker/entrypoint/ros2_entrypoint.sh /oss/entrypoint.sh
COPY --chown=ossuser:ossuser output/x86_64/${BUILD_TYPE}/extension/ros2/bin /oss/bin
COPY --chown=ossuser:ossuser output/x86_64/lib /oss/lib

# Generate unique machin_id
RUN if [ ! -s /etc/machine-id ]; then \
    echo "$(cat /proc/sys/kernel/random/uuid | tr -d '-')" > /etc/machine-id; \
    fi

RUN chmod +x /oss/entrypoint.sh

WORKDIR /oss
USER ossuser

ENV LD_LIBRARY_PATH=/oss/lib
ENV SAVED_REGISTRY_BACKUP=/oss/bin/config

ENTRYPOINT ["/oss/entrypoint.sh"]

