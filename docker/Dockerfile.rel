# Extension AGL - x86_64
###################################################################################
FROM runtime AS runtime-mmf-ext-agl-x86_64

ARG BUILD_TYPE=Release

COPY --chown=ossuser:ossuser docker/entrypoint/agl_entrypoint.sh /oss/entrypoint.sh
COPY --chown=ossuser:ossuser output/x86_64/${BUILD_TYPE}/extension/agl/bin /oss/bin
COPY --chown=ossuser:ossuser output/x86_64/lib /oss/lib

# Generate unique machin_id
