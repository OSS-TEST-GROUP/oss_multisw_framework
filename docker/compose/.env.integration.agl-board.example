# Orin 보드(arm64/AGL)용 통합 테스트 환경파일 샘플.
#   cp docker/compose/.env.integration.agl-board.example /root/oss/.env.integration
#   docker compose -f docker-compose-integration.yaml \
#                  -f docker-compose-agl-board.override.yaml \
#                  --env-file .env.integration up -d mmf-ext-agl
#
# 값은 보드 실측 기준이다. 자기 보드에서 확인하려면:
#   DOCKER_GID       : stat -c %g /var/run/docker.sock
#   HMI_RUNTIME_UID  : id -u agl-driver      (AGL 런타임 uid, 보통 1001)
DOCKER_GID=999
DOCKER_SOCK_GID=999
HMI_RUNTIME_UID=1001

# MMF·Autoware·rviz2 가 만나는 DDS 도메인. adsw 파티션이 42 이므로 42 로 통일한다.
ROS_DOMAIN_ID=42
MMF_DDS_DOMAIN_ID=42

# 호스트에 구성한 AGL 서비스 목록(보드 override 가 이 경로를 컨테이너로 마운트한다).
#   cp service/extension/agl/adsw_manager/config/agl-service-list.yaml /opt/adsw/config/
AGL_SERVICE_LIST=/opt/adsw/config/agl-service-list.yaml

# ext-agl 이미지. 기본(:latest)을 쓰려면 이 줄을 지운다.
# ⚠️ 2026-08 시점의 :latest 는 CI 캐시 재사용으로 7/20 바이너리가 들어간 낡은 빌드다
#    (라벨은 develop-20260731). develop 기준 재빌드 스냅샷을 권장한다.
IMAGE=registry.obigo.com/oss/oss-mmf-ext-agl:develop-20260806-169f697

# rviz2 컨테이너 이미지 (compose 의 rviz2-agl 서비스 + 런처 패널이 같은 태그를 쓴다).
# rviz2-agl 은 `up` 대상이 아니다(profiles: [rviz2]) — 이미지 프로비저닝 용도:
#   docker compose -f docker-compose-integration.yaml \
#                  -f docker-compose-agl-board.override.yaml \
#                  --env-file .env.integration pull rviz2-agl
# ⚠️ 패널의 기본값도 :latest 다(app_config.dart). 다른 태그를 쓰려면 런처 config.json
#    의 image 도 함께 바꿔야 둘이 갈라지지 않는다.
RVIZ2_IMAGE=registry.obigo.com/oss/rviz2-agl:latest
