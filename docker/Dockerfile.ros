FROM ubuntu:jammy
LABEL org.opencontainers.image.authors="Brian Doh <brian.doh@obigo.com>"

# Set base environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONUNBUFFERED=1
ENV ROS_DISTRO=humble

RUN if [ "$(uname -m)" = "aarch64" ]; then \
        sed -i 's|http://ports.ubuntu.com/ubuntu-ports|http://ftp.kaist.ac.kr/ubuntu-ports|g' /etc/apt/sources.list; \
    fi

RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'Acquire::http::Timeout "300";' >> /etc/apt/apt.conf.d/80-retries

RUN echo 'Asia/Seoul' > /etc/timezone && \
    ln -s /usr/share/zoneinfo/Asia/Seoul /etc/localtime

# install packages
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get update --fix-missing || \
    (sleep 10 && apt-get update --fix-missing) || \
    (sleep 30 && apt-get update --fix-missing) && \
    apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    dirmngr \
    gnupg2 \
    gzip \
    build-essential \
    cmake \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Setup ROS Apt sources
RUN curl -L -s -o /tmp/ros2-apt-source.deb https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.1.0/ros2-apt-source_1.1.0.jammy_all.deb \
    && echo "1600cb8cc28258a39bffc1736a75bcbf52d1f2db371a4d020c1b187d2a5a083b /tmp/ros2-apt-source.deb" | sha256sum --strict --check \
    && apt-get -o Acquire::AllowReleaseInfoChange=true update \
    && apt-get install /tmp/ros2-apt-source.deb \
    && rm -f /tmp/ros2-apt-source.deb \
    && rm -rf /var/lib/apt/lists/*

# install ros2 packages
RUN apt-get -o Acquire::AllowReleaseInfoChange=true update \
    && apt-get install -y --no-install-recommends \
    ros-humble-ros-core=0.10.0-1* \
    ros-humble-rosidl-generator-c \
    ros-humble-builtin-interfaces \
    ros-humble-rosidl-generator-py \
    ros-humble-rosidl-default-generators \
    ros-humble-rosbridge-server \
    ros-humble-geographic-msgs \
    ros-humble-autoware*msgs \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

RUN curl -v -u "builder:obigo@se" \
    -o /tmp/diagnosticmgr.tar.gz \
    https://repo.obigo.com/repository/ai2/oss/ros2/diagnosticmgr.tar.gz \
    && cd /tmp && tar xvf diagnosticmgr.tar.gz \
    && cd diagnosticmgr \
    && /bin/bash -c " \
    source /opt/ros/humble/setup.bash \
    && colcon build --install-base /opt/ros/humble/share/diagnosticmgr \
    && cd /tmp && rm -rf /tmp/diagnosticmgr* \
    "

RUN wget -O /tmp/tier4_autoware_msgs.tar.gz \
    https://github.com/tier4/tier4_autoware_msgs/archive/refs/tags/v0.58.0.tar.gz \
    && cd /tmp && tar xvf tier4_autoware_msgs.tar.gz \
    && cd tier4_autoware_msgs-0.58.0 \
    && /bin/bash -c "\
    source /opt/ros/humble/setup.bash \
    && colcon build --install-base /opt/ros/humble/share/tier4_autoware || true \
    && cd /tmp && rm -rf tier4_autoware_msgs* \
    "

# setup entrypoint
COPY ./docker/entrypoint/bridge_entrypoint.sh /ros_entrypoint.sh
RUN chmod a+x /ros_entrypoint.sh 

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
