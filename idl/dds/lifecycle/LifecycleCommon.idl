module lifecyclemgr {
    enum ServiceType
    {
        NORMAL,
        ONESHOT
    };

    enum RecoveryPolicy {
        R_DEFAULT,
        ALWAYS,
        ON_FAILURE,
        ON_SUCCESS,
        ON_NOT_RESPONDING,
        MANUAL
    };                 

    enum ReturnCode {
        SUCCESS,
        FAILED
    };

    enum ServiceMode {
        NORMAL,
        OTA_MODE
    };

    enum ServiceState {
        NOT_RUNNING,
        INITIALIZING,
        RUNNING,
        RUNNING_NO_RESPONSE,
        TERMINATING
    };

    struct DummyTypeT {
    };                 

    // 서비스가 어느 미들웨어 위에서 도는가. lifecycle_mgr 은 이 값으로 서비스를 묶어
    // START/STOP 요청을 보내므로(StateManager::... by MwType) **라우팅 키**다.
    // 값이 틀리면 엉뚱한 adsw_manager 가 요청을 집어간다 — 그리고 아무도 오류를 내지 않는다.
    //
    // ⚠ 열거자는 **끝에만** 추가할 것. 앞/중간에 넣으면 기존 값의 wire 표현이 밀린다.
    //
    // ⚠⚠ 열거자 설명은 **enum 본문 밖(여기)에만** 쓸 것. 본문 안에 `//` 주석을 두면
    //   Fast-DDS 런타임 IDL 파서(dds_bridge 의 동적 타입 로딩)가 이 파일과 이 파일을
    //   include 하는 모든 IDL 의 파싱에 실패한다 — 보드 실측 2026-09-04: 브릿지가
    //   등록하는 토픽이 34 → 17 로 반토막 나고 `dds_bridge` 가 rc=1 로 종료했다.
    //   fastddsgen(빌드 타임)은 통과하므로 빌드로는 안 잡힌다.
    //
    // 열거자 설명:
    //   MW_NATIVE — service/extension/general (EXTENSION_PLATFORM=GENERAL) 이 관리하는
    //     서비스. 미들웨어 프레임워크 없이 도는 **순수 프로세스/컨테이너**다.
    //     이 값이 없어서 general adsw_manager 는 자기 서비스를 ROS2 로 보고해 왔고,
    //     mw_type 이 라우팅 키이므로 ros2 adsw_manager 와 같은 버스에 있으면 **둘 다 같은
    //     요청에 반응**했다(그리고 아무도 오류를 내지 않았다).
    //     이름은 용도가 아니라 **서비스의 성질**을 가리킨다 — 현재 유일한 사용자는
    //     SiLS vECU 지만 general 판은 SiLS 전용이 아니다("Middleware-neutral variant …
    //     SiLS 등 비-ROS2 워크로드용", service/extension/CMakeLists.txt). MW_SILS 로 두면
    //     다음 비-ROS2 워크로드가 자기를 SiLS 라고 거짓 보고해야 한다.
    //     `NATIVE` 는 IDL 예약어라 못 쓴다("Illegal identifier: NATIVE is a keyword") —
    //     접두사는 같은 파일의 CT_UNKNOWN / CS_UNKNOWN 관례를 따른 것이다.
    //   MW_UNKNOWN — 변환 실패 sentinel. 이것이 없으면 fallback 이 ROS2 로 떨어져
    //     "모른다" 와 "ROS2 다" 가 구별되지 않는다. ContainerType::CT_UNKNOWN 과 같은 취지.
    enum MwType {
        ROS2,
        AGL,
        AUTOSAR,
        MW_NATIVE,
        MW_UNKNOWN
    };

    // F013: container as a first-class concept in lifecycle_mgr.
    // adsw_manager registers its containers alongside services so the
    // monitor / control surface can address them directly.
    enum ContainerType {
        CT_UNKNOWN,
        DOCKER,
        DOCKER_COMPOSE,
        K3S
    };

    enum ContainerState {
        CS_UNKNOWN,
        CONTAINER_STOPPED,
        CONTAINER_RUNNING,
        CONTAINER_PAUSED
    };

    struct Container {
        string name;            // unique identifier within a registration
        string image;            // docker image / kubernetes image
        string deploy_file;      // compose file or k8s manifest path
        string container_namespace;  // k8s namespace (or "" for plain docker)
        ContainerType type;
    };
};