module lifecyclemgr {
    enum ServiceType
    {
        NORMAL,
        ONESHOT
    };

    enum RecoveryPolicy {
        R_DEFAULT,
        ALWAYS,
        ON_FAILURE,
        ON_SUCCESS,
        ON_NOT_RESPONDING,
        MANUAL
    };                 

    enum ReturnCode {
        SUCCESS,
        FAILED
    };

    enum ServiceMode {
        NORMAL,
        OTA_MODE
    };

    enum ServiceState {
        NOT_RUNNING,
        INITIALIZING,
        RUNNING,
        RUNNING_NO_RESPONSE,
        TERMINATING
    };

    struct DummyTypeT {
    };                 

    enum MwType {
        ROS2,
        AGL,
        AUTOSAR
    };

    // F013: container as a first-class concept in lifecycle_mgr.
    // adsw_manager registers its containers alongside services so the
    // monitor / control surface can address them directly.
    enum ContainerType {
        CT_UNKNOWN,
        DOCKER,
        DOCKER_COMPOSE,
        K3S
    };

    enum ContainerState {
        CS_UNKNOWN,
        CONTAINER_STOPPED,
        CONTAINER_RUNNING,
        CONTAINER_PAUSED
    };

    struct Container {
        string name;            // unique identifier within a registration
        string image;            // docker image / kubernetes image
        string deploy_file;      // compose file or k8s manifest path
        string container_namespace;  // k8s namespace (or "" for plain docker)
        ContainerType type;
    };
};