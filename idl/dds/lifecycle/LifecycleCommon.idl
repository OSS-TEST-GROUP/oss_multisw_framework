module lifecyclemgr {
    enum ServiceType
    {
        NORMAL,
        ONESHOT
    };

    enum RecoveryPolicy {
        R_DEFAULT,
        ALWAYS,
        ON_FAILURE,
        ON_SUCCESS,
        ON_NOT_RESPONDING,
        MANUAL
    };                 

    enum ReturnCode {
        SUCCESS,
        FAILED
    };

    enum ServiceMode {
        NORMAL,
        OTA_MODE
    };

    enum ServiceState {
        NOT_RUNNING,
        INITIALIZING,
        RUNNING,
        RUNNING_NO_RESPONSE,
        TERMINATING
    };

    struct DummyTypeT {
    };                 

    // 서비스가 어느 미들웨어 위에서 도는가. lifecycle_mgr 은 이 값으로 서비스를 묶어
    // START/STOP 요청을 보내므로(StateManager::... by MwType) **라우팅 키**다.
    // 값이 틀리면 엉뚱한 adsw_manager 가 요청을 집어간다 — 그리고 아무도 오류를 내지 않는다.
    //
    // ⚠ 열거자는 **끝에만** 추가할 것. 앞/중간에 넣으면 기존 값의 wire 표현이 밀린다.
    enum MwType {
        ROS2,
        AGL,
        AUTOSAR,
        // service/extension/general (EXTENSION_PLATFORM=GENERAL) 이 관리하는 서비스 —
        // 미들웨어 프레임워크 없이 도는 **순수 프로세스/컨테이너**다.
        //
        // 이 값이 없어서 general adsw_manager 는 자기 서비스를 ROS2 로 보고해 왔다.
        // mw_type 은 라우팅 키이므로(lifecycle_mgr 의 StateManager 가 이 값으로 묶어
        // START/STOP 을 보낸다) ros2 adsw_manager 와 같은 버스에 있으면 **둘 다 같은
        // 요청에 반응**한다. 그리고 아무도 오류를 내지 않는다.
        //
        // ⚠ 이름에 대해 — 용도가 아니라 **서비스의 성질**을 가리킨다.
        //   현재 유일한 사용자는 SiLS vECU(raw Fast DDS 참가자, ROS 2 노드 그래프로
        //   제어·감시되지 않는다)지만, general 판은 SiLS 전용이 아니다
        //   ("Middleware-neutral variant … SiLS 등 비-ROS2 워크로드용",
        //    service/extension/CMakeLists.txt). MW_SILS 로 두면 다음 비-ROS2 워크로드가
        //   자기를 SiLS 라고 거짓 보고해야 하고, 그건 이 값이 고치려는 버그 그 자체다.
        //
        // ⚠⚠ `NATIVE` 로는 못 쓴다 — IDL 예약어라 fastddsgen 이 거부한다
        //   ("Illegal identifier: NATIVE is a keyword"). 접두사는 같은 파일의
        //   CT_UNKNOWN / CS_UNKNOWN 관례를 따른 것이다.
        MW_NATIVE,
        // 변환 실패 sentinel. 이것이 없으면 fallback 이 ROS2 로 떨어져 "모른다" 와
        // "ROS2 다" 가 구별되지 않는다. ContainerType::CT_UNKNOWN 과 같은 취지.
        MW_UNKNOWN
    };

    // F013: container as a first-class concept in lifecycle_mgr.
    // adsw_manager registers its containers alongside services so the
    // monitor / control surface can address them directly.
    enum ContainerType {
        CT_UNKNOWN,
        DOCKER,
        DOCKER_COMPOSE,
        K3S
    };

    enum ContainerState {
        CS_UNKNOWN,
        CONTAINER_STOPPED,
        CONTAINER_RUNNING,
        CONTAINER_PAUSED
    };

    struct Container {
        string name;            // unique identifier within a registration
        string image;            // docker image / kubernetes image
        string deploy_file;      // compose file or k8s manifest path
        string container_namespace;  // k8s namespace (or "" for plain docker)
        ContainerType type;
    };
};