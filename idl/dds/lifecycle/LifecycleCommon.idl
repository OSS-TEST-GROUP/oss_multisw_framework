module lifecyclemgr {
    enum ServiceType
    {
        NORMAL,
        ONESHOT
    };

    enum RecoveryPolicy {
        R_DEFAULT,
        ALWAYS,
        ON_FAILURE,
        ON_SUCCESS,
        ON_NOT_RESPONDING,
        MANUAL
    };                 

    enum ReturnCode {
        SUCCESS,
        FAILED
    };

    enum ServiceMode {
        NORMAL,
        OTA_MODE
    };

    enum ServiceState {
        NOT_RUNNING,
        INITIALIZING,
        RUNNING,
        RUNNING_NO_RESPONSE,
        TERMINATING
    };

    struct DummyTypeT {
    };                 
};