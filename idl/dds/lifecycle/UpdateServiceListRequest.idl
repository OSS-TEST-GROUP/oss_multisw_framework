#include "LifecycleCommon.idl"

module lifecyclemgr {

    struct Service {
        string name;
        ServiceType service_type;
        RecoveryPolicy recovery_policy;
        boolean is_enabled;
        OsType os_type;
    };

    /* TopicName - mmf/lifecyclemgr/UpdateServiceListRequest */
    struct UpdateServiceListRequest {
        sequence<Service> service_list;
    };

    /* TopicName - mmf/lifecyclemgr/UpdateServiceListResponse */
    struct UpdateServiceListResponse {
        ReturnCode ret_code;
    };
};