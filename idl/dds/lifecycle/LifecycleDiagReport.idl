#include "LifecycleCommon.idl"

module lifecyclemgr {

    struct ServiceStatus {
        string name;
        ServiceType service_type;
        ServiceState service_state;
        boolean is_enabled;
        int32 recovered_count;
    };

    /* TopicName - mmf/lifecyclemgr/LifecycleDiagReport */
    struct LifecycleDiagReport {
        boolean     is_started;
        int32       running_service_num;
        int32       total_services_num;        
        sequence<ServiceStatus> service_list;
    };
};