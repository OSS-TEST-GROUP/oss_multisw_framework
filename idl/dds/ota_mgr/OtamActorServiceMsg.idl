#include "common/ReturnValue.idl"

/**
[Topic] “/mmf/otamanager/otaactor_service/GetAppUpdateSettings”
**/
module otamanager {
// Define a Request struct
    struct GetAppUpdateSettings {
        long id;          // Request ID
        string app_name;
    };
};

/**
[Topic] “/mmf/otamanager/otaactor_service/GetAppUpdateSettingsResponse”
**/
module otamanager {
    struct GetAppUpdateSettingsResponse {
        long id; // Response ID (matching the Request ID)
        string app_name;
        string app_settings;
        ReturnValue ret_code;
    };
};

/**
[Topic] “/mmf/otamanager/otaactor_service/SetAppUpdateSettings”
**/
module otamanager {
    struct SetAppUpdateSettings {
        long id;          // Request ID
        string app_name;
        string app_settings;      
    };
};

/**
[Topic] “/mmf/otamanager/otaactor_service/SetAppUpdateSettingsResponse”
**/
module otamanager {
    // Define a Response struct
    struct SetAppUpdateSettingsResponse {
        long id;  // Response ID (matching the Request ID)
        ReturnValue ret_code;
    };
};


