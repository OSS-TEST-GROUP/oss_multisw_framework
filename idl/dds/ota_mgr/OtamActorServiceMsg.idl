#include "common/ReturnValue.idl"

module ota_manager {
module msg {

/**
[Topic] "/mmf/otamanager/otaactor_service/GetAppUpdateSettings"
**/
// Define a Request struct
struct GetAppUpdateSettings {
    @key long id;          // Request ID
    string app_name;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/GetAppUpdateSettingsResponse"
**/
struct GetAppUpdateSettingsResponse {
    @key long id; // Response ID (matching the Request ID)
    string app_name;
    string app_settings;
    ReturnValue ret_code;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/SetAppUpdateSettings"
**/
struct SetAppUpdateSettings {
    @key long id;          // Request ID
    string app_name;
    string app_settings;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/SetAppUpdateSettingsResponse"
**/
// Define a Response struct
struct SetAppUpdateSettingsResponse {
    @key long id;  // Response ID (matching the Request ID)
    ReturnValue ret_code;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/GetAppUpdateState"
**/
struct GetAppUpdateState {
    @key long id;          // Request ID
    string app_name;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/GetAppUpdateStateResponse"
**/
struct GetAppUpdateStateResponse {
    @key long id; // Response ID (matching the Request ID)
    string app_name;
    string app_state_info;
    ReturnValue ret_code;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/SetAppUpdate"
**/
struct SetAppUpdate {
    @key long id;          // Request ID
    string app_name;
};

/**
[Topic] "/mmf/otamanager/otaactor_service/SetAppUpdateResponse"
**/
struct SetAppUpdateResponse {
    @key long id; // Response ID (matching the Request ID)
    string app_name;
    ReturnValue ret_code;
};

}; // module msg
}; // module ota_manager
