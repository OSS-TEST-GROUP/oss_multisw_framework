#include "common/ReturnValue.idl"

/** 
[Topic] “/mmf/otamanager/otaclient_service/SetOtaClientRegistration”
**/
module otamanager {
    struct SetOtaClientRegistration {
        string client_name;
        sequence<string> app_list;
    };
};

/** 
[Topic] “/mmf/otamanager/otaclient_service/SetOtaClientRegistrationResponse
**/
module otamanager {
    struct SetOtaClientRegistrationResponse {
        long client_id;
        ReturnValue ret_code;
    };
};

/** 
[Topic] “/mmf/otamanager/otaclient_service/NotifyOtaManagerReady”
**/
module otamanager {
    struct NotifyOtaManagerReady {
    };
};

/**
[Topic] “/mmf/otamanager/otaclient_service/NotifyAppUpdateStatus”
**/

module otamanager {
    struct NotifyAppUpdateStatus {
        @key long client_id;
        string app_name;
        string status;
    };
};

/**
[Topic] "/mmf/otamanager/otaclient_service/GetAppList"

F022 — request a snapshot of every (client × app) pair currently
registered with the Manager. The OtamClientService is the source of
truth (ota_client_info_list_).
**/
module otamanager {
    struct GetAppList {
        @key long id;
    };
};

/**
[Topic] "/mmf/otamanager/otaclient_service/GetAppListResponse"

Parallel arrays:
  app_names[i]        — application name (deduplicated, sorted)
  owner_client_ids[i] — id of the client that registered app_names[i]
                         (when the same app is registered by multiple
                          clients, the lowest client_id wins)
**/
module otamanager {
    struct GetAppListResponse {
        @key long id;
        sequence<string> app_names;
        sequence<long>   owner_client_ids;
        ReturnValue ret_code;
    };
};
