// Canonical ego-vehicle STATE -- SiLS sim-agnostic plant-coupling contract (Option 2,
// bus-coupled external world). docs/sils/sils-morai-plant-adapter-design.md,
// sils-morai-simulator-integration-review.md (§3.2 data plane, P0).
//
// A sim adapter (MORAI / AWSIM / rosbag) is an ANTI-CORRUPTION LAYER: it translates its
// native message into THIS canonical SI form so the bus contract never changes when the
// sim does. Concretely for MORAI morai_msgs/EgoVehicleStatus the adapter MUST convert:
//   - front_steer   deg  -> rad   (steering_angle)
//   - angular vel   deg/s -> rad/s (yaw_rate)
//   - velocity      km/h -> m/s
// Omitting these skews the steering/yaw loop by ~57.3x (integration-review). The
// conversion lives ONLY in the adapter; consumers (vECU, Autoware bridge) read canonical.
//
// Generated by the top-level IDL step (idl/dds/CMakeLists.txt) into
// ${CMAKE_INSTALL_PREFIX}/generated/idl/sils/. EgoStateVec3 is named uniquely (not a bare
// "Vec3") so it never collides with another IDL's type in the shared TypeObject registry
// (see the multi-def note in service/sils/vecu/CMakeLists.txt).

// A 3-vector; SI unit depends on the field (m, m/s, or m/s^2).
struct EgoStateVec3
{
    double x;
    double y;
    double z;
};

struct EgoState
{
    string             run_id;          // correlate to the Coordinator run
    unsigned long long seq;             // source sequence, monotonic (§2.2 sequence)
    long long          stamp_ns;        // source timestamp on the sim clock, ns (§2.2)
    EgoStateVec3       position;        // map frame, m
    EgoStateVec3       orientation_rpy; // roll / pitch / yaw, rad
    EgoStateVec3       velocity;        // vehicle frame, m/s
    EgoStateVec3       acceleration;    // vehicle frame, m/s^2
    double             yaw_rate;        // rad/s   (MORAI deg/s -> rad/s)
    double             steering_angle;  // front road-wheel angle, rad (MORAI deg -> rad)
    octet              gear;            // 0=PARK 1=REVERSE 2=NEUTRAL 3=DRIVE
};
