// Canonical control TARGET -- Autoware control mirror for the Vehicle Interface (VCU),
// SiLS plant-coupling (Option 2). docs/sils/sils-vehicle-interface-autoware.md.
//
// What Autoware WANTS (target), the input side of the VCU. An external Autoware<->DDS
// bridge (anti-corruption layer, NOT SiLS) translates autoware_control_msgs/Control +
// autoware_vehicle_msgs/GearCommand into this SI-canonical form so the VCU never has to
// match ROS2 type name/hash/CDR (integration-review §3.4). Field parity with Autoware is
// near 1:1 -- steering_tire_angle and longitudinal.acceleration are already rad / m/s^2.
//
// Distinct from VehicleControl though the fields match: ControlTarget = the desired target
// (Autoware -> VCU); VehicleControl = what the VCU commands the plant AFTER arbitration /
// safety (VCU -> MORAI). The VCU maps + arbitrates one into the other. Longitudinal is a
// single fixed mode (acceleration), same as VehicleControl.
//
// Generated into ${CMAKE_INSTALL_PREFIX}/generated/idl/sils/. gear uses the same octet
// encoding as EgoState/VehicleControl (no shared named type -> no duplicate TypeObject
// registration; see service/sils/vecu/CMakeLists.txt).

struct ControlTarget
{
    string             run_id;         // correlate to the run
    unsigned long long seq;            // command sequence, monotonic
    long long          stamp_ns;       // command timestamp, ns
    double             steering_angle; // rad  (= Control.lateral.steering_tire_angle)
    double             acceleration;   // m/s^2 (= Control.longitudinal.acceleration)
    octet              gear;           // 0=PARK 1=REVERSE 2=NEUTRAL 3=DRIVE
};
