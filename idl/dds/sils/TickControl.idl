// SiLS lockstep clock control plane -- architecture v3 Final §8.2.
//
// ClockMaster publishes TickGrant; each participating vECU replies TickComplete.
// The control plane shares the run's DDS domain (§12.1: SUT, vECU, control plane
// all on the same domain id). These types are generated by the top-level IDL step
// (idl/dds/CMakeLists.txt) into ${CMAKE_INSTALL_PREFIX}/generated/idl/sils/.

struct TickGrant
{
    string run_id;
    unsigned long long tick_seq;
    long long sim_time_ns;
    long long dt_ns;
};

struct TickComplete
{
    string run_id;
    unsigned long long tick_seq;
    string participant_id;
    long status;              // 0 = ok
};
