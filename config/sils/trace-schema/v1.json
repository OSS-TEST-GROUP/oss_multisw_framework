{
  "schema_version": 1,
  "description": "SiLS vECU trace event schema v1. The JSONL trace a run emits IS the public conformance boundary (docs/sils-extension-model.md §2): the conformance kit (evaluate.py / parity.py / validate_trace.py) consumes only this. `required` fields are grounded in real captured traces (always present); other fields are allowed (forward-compatible). Every line is one JSON object with at least `run_id` and `event`. Events span all six producers of a merged run trace -- the vECU plus the harness (coordinator/clock/responder/verifier/input_source); use validate_trace --producer to check one producer's slice.",
  "base_required": ["run_id", "event"],
  "producers": {
    "vecu": "the vECU probe itself (sils::RunProbe, run_loop.hpp) -- what a developer ECU emits for free",
    "coordinator": "the Run Coordinator (service/sils/run_coordinator/run_phase1.sh) -- lifecycle + terminal verdict",
    "clock_master": "the lockstep ClockMaster (sils_clock_master.cc)",
    "responder": "the L1 SUT stand-in responder (viss_responder_main.cc)",
    "verifier": "the run verifier (viss_verify_main.cc)",
    "input_source": "the async input source fixture (sils_input_source.cc)",
    "sim_fixture": "plant-coupling test fixtures (sils_ego_source.cc / sils_control_source.cc) -- stand-ins for the MORAI/AWSIM STATE broadcast and the Autoware<->DDS control bridge; a real run replaces them with the sim adapter"
  },
  "events": {
    "run_start":         {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "domain_id"], "note": "also emitted by the coordinator (adds backend); the vECU additionally carries the seq/topic envelope -- required is the intersection always present in either"},
    "wire_start":        {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "name", "type"], "since": 1},
    "qos_negotiated":    {"producer": "vecu", "required": ["role", "reliability", "durability", "wall_time_ms"]},
    "protocol_on":       {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "mode", "response_topic"]},
    "protocol_ready":    {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "response_matched", "waited_ms"]},
    "ready":             {"producer": "vecu", "required": ["instance_id", "wall_time_ms"], "note": "also emitted by the plant-coupling vehicle probe (vehicle_run.hpp) without the VISS seq/topic envelope -- required is the intersection always present"},
    "clock_start":       {"producer": "clock_master", "required": ["mode", "wall_time_ms"]},
    "behavior_start":    {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "name"], "note": "also emitted by the vehicle probe without the seq/topic envelope"},
    "scenario_start":    {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "name", "scheduled_faults"]},
    "target_attestation":{"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "arch", "gateway", "protocol"]},
    "plant_reset":       {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "model", "mode", "initial"]},
    "endpoint_matched":  {"producer": "vecu", "required": ["matched_count", "wall_time_ms"]},
    "endpoint_unmatched":{"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "matched_count"]},
    "behavior_output":   {"producer": "vecu", "required": ["instance_id", "behavior", "tick_seq", "value"]},
    "publish_intent":    {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "matched_count"]},
    "request_sent":      {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "request_id", "path", "action"]},
    "scenario_fault":    {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "fault", "request_id"]},
    "publish_result":    {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic"]},
    "plant_step":        {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "tick_seq", "sim_time_ns", "dt_ns", "feedback_in", "command", "output"]},
    "response_received": {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "request_id", "status"]},
    "input_staging_on":  {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "late_sample_policy"], "note": "VISS carries input_topic; the vehicle probe carries state_channels/target_channels (MIMO). late_sample_policy is the common field"},
    "input_received":    {"producer": "vecu", "required": ["instance_id", "recv_seq"], "note": "MIMO plant-coupling adds a `channel` field so per-channel recv_seq streams are attributable"},
    "tick_input_frozen": {"producer": "vecu", "required": ["instance_id", "tick_seq", "recv_seqs", "count"], "note": "MIMO plant-coupling adds a `channel` field; the §7.3 order/dup/phantom invariant then holds per channel"},
    "replay_start":      {"producer": "vecu", "required": ["instance_id", "seq", "wall_time_ms", "topic", "file", "inputs"]},
    "tick_complete":     {"producer": "vecu", "required": ["instance_id", "tick_seq", "sim_time_ns"], "note": "emitted by any lockstep barrier participant -- the vECU probe AND lockstep-aware fixtures (ego/control source), distinguished by instance_id/participant_id"},
    "run_stopping":      {"producer": "vecu", "required": ["instance_id", "wall_time_ms"], "note": "also the vehicle probe (no seq/topic envelope)"},
    "run_stopped":       {"producer": "vecu", "required": ["instance_id", "wall_time_ms"], "note": "also the vehicle probe (no seq/topic envelope)"},

    "channelmap_start":  {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "file", "channels"], "note": "plant-coupling (Option 2): the vehicle probe bound a channel map (vehicle_run.hpp)"},
    "channel_bound":     {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "name", "dir", "topic", "type"], "note": "plant-coupling: one MIMO channel (in/out) resolved to a DDS topic+type"},
    "state_received":    {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "tick_seq"], "note": "plant-coupling: the vECU consumed a bus EgoState this tick (closed-loop feedback, §9)"},
    "target_received":   {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "tick_seq"], "note": "plant-coupling Profile B: an upstream control target (Autoware via the bridge) this tick"},
    "control_published": {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "tick_seq", "behavior"], "note": "plant-coupling: the vECU published a unified VehicleControl to the plant this tick (steering_angle/acceleration/gear)"},
    "input_fault_on":    {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "schedule", "faults"], "note": "plant-coupling negative path (IInputFault, vehicle_input_fault.hpp): a deterministic inbound-state fault schedule (SILS_INPUT_FAULTS) is active; `faults` = scheduled count"},
    "input_fault":       {"producer": "vecu", "required": ["instance_id", "wall_time_ms", "tick_seq", "mode"], "note": "plant-coupling negative path: one injected inbound-state fault this tick (mode = drop/nan/oor; adds a `channel` field). analyze_fault checks the command that tick stayed finite (safe degradation)"},

    "tick_grant":        {"producer": "clock_master", "required": ["tick_seq", "sim_time_ns", "dt_ns", "wall_time_ms"]},
    "tick_barrier":      {"producer": "clock_master", "required": ["tick_seq", "completed", "wall_time_ms"]},
    "clock_stop":        {"producer": "clock_master", "required": ["exit_code", "wall_time_ms"]},

    "responder_start":   {"producer": "responder", "required": ["role", "domain_id", "response_topic", "wall_time_ms"]},
    "responder_reply":   {"producer": "responder", "required": ["role", "request_id", "status", "wall_time_ms"]},
    "responder_stop":    {"producer": "responder", "required": ["role", "handled", "wall_time_ms"]},

    "verify_start":      {"producer": "verifier", "required": ["expected_instance_id", "domain_id", "topic", "wall_time_ms"]},
    "sample_received":   {"producer": "verifier", "required": ["expected_instance_id", "received_count", "topic", "valid_envelope", "wall_time_ms"]},
    "verify_pass":       {"producer": "verifier", "required": ["expected_instance_id", "received_count", "valid_count", "min_samples", "topic", "wall_time_ms"]},
    "verify_fail":       {"producer": "verifier", "required": ["expected_instance_id", "received_count", "valid_count", "min_samples", "topic", "wall_time_ms"]},

    "input_source_start":{"producer": "input_source", "required": ["count", "rate_ms", "topic"]},
    "input_source_sent": {"producer": "input_source", "required": ["seq", "topic"]},
    "input_source_done": {"producer": "input_source", "required": ["sent"]},

    "ego_source_start":  {"producer": "sim_fixture", "required": ["topic", "mode", "count"]},
    "ego_source_sent":   {"producer": "sim_fixture", "required": ["seq"]},
    "ego_source_done":   {"producer": "sim_fixture", "required": ["sent"]},
    "control_source_start":{"producer": "sim_fixture", "required": ["topic", "mode", "count"]},
    "control_source_sent": {"producer": "sim_fixture", "required": ["seq"]},
    "control_source_done": {"producer": "sim_fixture", "required": ["sent"]},

    "domain_leased":     {"producer": "coordinator", "required": ["wall_time_ms", "domain_id", "pool"]},
    "domain_released":   {"producer": "coordinator", "required": ["wall_time_ms"]},
    "domain_pool_exhausted": {"producer": "coordinator", "required": ["wall_time_ms", "pool"]},
    "domain_alloc_failed":{"producer": "coordinator", "required": ["wall_time_ms"]},
    "process_running":   {"producer": "coordinator", "required": ["wall_time_ms"]},
    "vecu_ready":        {"producer": "coordinator", "required": ["wall_time_ms"]},
    "verify_invoke":     {"producer": "coordinator", "required": ["wall_time_ms"]},
    "cleanup_done":      {"producer": "coordinator", "required": ["wall_time_ms"]},
    "cleanup_noop":      {"producer": "coordinator", "required": ["wall_time_ms"]},
    "run_pass":          {"producer": "coordinator", "required": ["wall_time_ms"]},
    "run_fail":          {"producer": "coordinator", "required": ["wall_time_ms", "verify_exit_code"]},
    "ready_timeout":     {"producer": "coordinator", "required": ["wall_time_ms"]},
    "start_failed":      {"producer": "coordinator", "required": ["wall_time_ms", "reason"]},
    "orphan_detected":   {"producer": "coordinator", "required": ["wall_time_ms", "reason"]},
    "aborted_orphaned":  {"producer": "coordinator", "required": ["wall_time_ms", "reason"]},
    "fmu_gate_allowed":  {"producer": "coordinator", "required": ["wall_time_ms", "fmu"]},
    "fmu_gate_denied":   {"producer": "coordinator", "required": ["wall_time_ms", "fmu"]},
    "fleet_start":       {"producer": "coordinator", "required": ["wall_time_ms", "domain_id", "backend", "members"]},
    "fleet_ready":       {"producer": "coordinator", "required": ["wall_time_ms", "members"]},
    "fleet_start_failed":{"producer": "coordinator", "required": ["wall_time_ms"]},
    "member_start":      {"producer": "coordinator", "required": ["wall_time_ms", "instance_id", "index"]}
  }
}
